# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to GitHub

# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Admin API key — set any strong random secret (e.g. openssl rand -hex 32)
# When set, all /api/dashboard and /api/ai-insight calls require header: X-Admin-Key: <value>
# Leave empty to disable auth (development only — NEVER leave empty in production)
ADMIN_API_KEY=change_me_to_a_strong_secret

# App environment
APP_ENV=production
APP_VERSION=1.0.0
